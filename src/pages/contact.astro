---
import Base from '../layouts/Base.astro';
import '../styles/global.css';
---

<Base title="Contact — Allan Reyes">

  <section class="max-w-6xl mx-auto px-6 pt-24 pb-32 md:pt-32">

    <div class="flex items-center gap-4 mb-16">
      <div class="bauhaus-line"></div>
      <span class="text-sm font-mono uppercase tracking-widest opacity-50">Contact</span>
    </div>

    <div class="grid md:grid-cols-12 gap-12 md:gap-16">

      <div class="md:col-span-5">
        <h1 class="text-4xl md:text-5xl font-bold leading-tight mb-8">
          Let's talk.
        </h1>
        <p class="text-lg leading-relaxed opacity-70 mb-12">
          Whether you're looking for a design engineer to join your team, need help
          shaping a product's design system, or want to collaborate on something
          interesting — I'd like to hear from you.
        </p>

        <div class="space-y-4 text-sm opacity-50">
          <div class="flex items-center gap-3">
            <div class="w-1.5 h-1.5 bg-current"></div>
            <a href="https://www.linkedin.com/in/allanreyes/" target="_blank" rel="noopener" class="link-underline">LinkedIn</a>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-1.5 h-1.5 bg-current"></div>
            <a href="https://dribbble.com/pixeleden" target="_blank" rel="noopener" class="link-underline">Dribbble</a>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-1.5 h-1.5 bg-current"></div>
            <a href="https://www.instagram.com/ulampinoy/" target="_blank" rel="noopener" class="link-underline">Instagram</a>
          </div>
        </div>
      </div>

      <div class="md:col-span-6 md:col-start-7">
        <form
          name="contactForm"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="space-y-8"
        >
          <input type="hidden" name="form-name" value="contactForm" />
          <p class="hidden">
            <label>Don't fill this out: <input name="bot-field" /></label>
          </p>

          <div>
            <label for="name" class="block text-xs font-mono uppercase tracking-wider opacity-40 mb-3">Name</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full bg-transparent border-b border-dark/20 dark:border-light/20 py-3 text-base focus:border-dark dark:focus:border-light outline-none transition-colors"
              placeholder="Your name"
            />
          </div>

          <div>
            <label for="email" class="block text-xs font-mono uppercase tracking-wider opacity-40 mb-3">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full bg-transparent border-b border-dark/20 dark:border-light/20 py-3 text-base focus:border-dark dark:focus:border-light outline-none transition-colors"
              placeholder="your@email.com"
            />
          </div>

          <div>
            <label for="message" class="block text-xs font-mono uppercase tracking-wider opacity-40 mb-3">Message</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              class="w-full bg-transparent border-b border-dark/20 dark:border-light/20 py-3 text-base focus:border-dark dark:focus:border-light outline-none transition-colors resize-none"
              placeholder="Tell me about your project or opportunity..."
            ></textarea>
          </div>

          <button
            type="submit"
            class="border border-dark dark:border-light px-8 py-3 text-sm font-medium uppercase tracking-wider hover:bg-dark hover:text-light dark:hover:bg-light dark:hover:text-dark transition-colors duration-300"
          >
            Send Message
          </button>
        </form>
      </div>

    </div>
  </section>

</Base>
